model Vehicle {
  id               String             @id @default(uuid())
  userId           String?            @map("user_id")
  user             User?              @relation(fields: [userId], references: [id])
  enterpriseId     String?            @map("enterprise_id")
  enterprise       Enterprise?        @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  homeCenterId     String?            @map("home_center_id")
  homeCenter       MaintenanceCenter? @relation("VehicleHomeCenter", fields: [homeCenterId], references: [id], onDelete: SetNull)
  brand            String
  model            String
  year             Int
  vin              String?
  plate            String?
  // Plaque normalisée (majuscules, sans séparateur) : clé de déduplication du
  // parc. Voir apps/api/src/lib/plate.ts — `plate` reste la saisie d'origine.
  plateCanonical   String?            @map("plate_canonical")
  engine           String?
  mileage          Int?
  mileageUpdatedAt DateTime?          @map("mileage_updated_at")
  usageType        VehicleUsageType?  @map("usage_type")
  energyType       VehicleEnergyType? @map("energy_type")
  groupName        String?            @map("group_name")
  photoUrl         String?            @map("photo_url")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  orders                 Order[]
  maintenanceSchedules   MaintenanceSchedule[]
  driverAssignments      DriverAssignment[]
  driverDailyRecords     DriverDailyRecord[]
  driverIncidents        DriverIncident[]
  partRequests           PartRequest[]
  logisticsQuoteRequests LogisticsQuoteRequest[]

  @@index([userId], name: "idx_vehicles_user")
  @@index([enterpriseId], name: "idx_vehicles_enterprise")
  @@index([plate], name: "idx_vehicles_plate")
  // Index de recherche. L'unicité (enterprise_id, plate_canonical) est en plus
  // un index UNIQUE *partiel* — non exprimable en Prisma — créé par la migration
  // 20260730_vehicle_plate_unique. Un `db:push` le supprimerait : le recréer à
  // la main si vous prototypez avec push.
  @@index([enterpriseId, plateCanonical], name: "idx_vehicles_enterprise_plate_canonical")
  @@index([homeCenterId], name: "idx_vehicles_home_center")
  @@map("vehicles")
}

