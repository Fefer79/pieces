  @@index([driverId], name: "idx_driver_incidents_driver")
  @@index([vehicleId], name: "idx_driver_incidents_vehicle")
  @@map("driver_incidents")
}

// ---------------------------------------------------------------------------
// Agent Fiche Terrain — fiches produit générées par photo (spec v1.1)
// ---------------------------------------------------------------------------

enum EnrichmentOrigin {
  LIAISON
  VENDEUR
}

// Statuts de workflow volontairement génériques : côté Liaison/vendeur ils se
// lisent comme des étapes de modération classiques ; le sens complet (lien avec
// le score d'authenticité) n'existe qu'au niveau administrateur.
enum EnrichmentStatus {
  BROUILLON
  EN_MODERATION
  A_VERIFIER // inspection physique programmée (motif non exposé hors admin)
  VALIDE
  BLOQUE // revue manuelle anti-contrefaçon (jamais exposé tel quel hors admin)
}

model PartEnrichment {
  id     String  @id @default(cuid())
  partId String? @map("part_id") // CatalogItem créé à la publication

  origine EnrichmentOrigin
  statut  EnrichmentStatus @default(BROUILLON)

  identification  Json?
  classification  Json?
  photoFeedback   String? @map("photo_feedback")
  // score, signaux, justification — accès administrateur exclusif : le champ
  // est ABSENT des réponses API pour les autres rôles (pas null).
  authenticite    Json?
  fitments        Json?
  // Phase 2 (batch nocturne) : cross-références, fournisseurs, contacts
  // producteurs. Réservé au tableau de bord administrateur.
  sourcing        Json?
  sourcingBatchId String? @map("sourcing_batch_id")

  // Livrables clients flottes, publiés après approbation admin.
  noteQualite             Int?      @map("note_qualite")
  descriptionIndependante String?   @map("description_independante")
  livrablesApprouvesAt    DateTime? @map("livrables_approuves_at")

  confianceGlobale Float? @map("confiance_globale")

  photos         String[] // URLs stockage R2 (originaux, EXIF conservés)
  photoHashes    String[] @map("photo_hashes") // hash perceptuel anti-réutilisation
  // Variantes WebP par photo (thumb/small/medium/large) pour la publication
  // catalogue : [{ urlOriginal, urlThumb, urlSmall, urlMedium, urlLarge }]
  photosVariants Json?    @map("photos_variants")

  // Saisie humaine (prix/stock/garantie déclarés avec le vendeur)
  prix          Int?
  stockQuantite Int?    @map("stock_quantite")
  warrantyValue Int?    @map("warranty_value")
  warrantyUnit  String? @map("warranty_unit")

  liaisonId         String? @map("liaison_id") // créateur (mode Liaison) ou modérateur (mode vendeur)
  liaison           User?   @relation("EnrichmentLiaison", fields: [liaisonId], references: [id])
  vendeurId         String? @map("vendeur_id") // Vendor créateur/rattaché
  vendeur           Vendor? @relation("EnrichmentVendeur", fields: [vendeurId], references: [id])
  fournisseurVisite String? @map("fournisseur_visite")

  corrections Json? // diff agent vs validation humaine (jeu de données précision)
  tentatives  Int   @default(1) // resoumissions de la même pièce (signal fraude)

  contentValidatedAt DateTime? @map("content_validated_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  validatedAt        DateTime? @map("validated_at")

  @@index([liaisonId], name: "idx_part_enrichments_liaison")
  @@index([vendeurId, createdAt], name: "idx_part_enrichments_vendeur_date")
  @@index([statut], name: "idx_part_enrichments_statut")
  @@map("part_enrichments")
}

model CrossReference {
  id          String   @id @default(cuid())
  refSource   String   @map("ref_source") // réf OEM pivot
  refCible    String   @map("ref_cible")
  marqueCible String   @map("marque_cible")
  type        String // aftermarket | oem_croisee
  sourceUrl   String   @map("source_url")
  verifieLe   DateTime @map("verifie_le")

  @@unique([refSource, refCible, marqueCible], name: "uq_cross_reference")
  @@index([refSource], name: "idx_cross_references_source")
  @@map("cross_references")
}

model ManufacturerContact {
  id        String   @id @default(cuid())
  marque    String
  entite    String
  role      String
  email     String?
  telephone String?
  url       String
  verifieLe DateTime @map("verifie_le")

  @@unique([marque, entite, role], name: "uq_manufacturer_contact")
  @@index([marque], name: "idx_manufacturer_contacts_marque")
  @@map("manufacturer_contacts")
}

enum ContactStatus {
  A_CONTACTER
  APPELE
  VISITE
  RELANCE
  CONCLU
  INJOIGNABLE
  A_REVOIR
  REJETE
}

model VendorContact {
  id               String              @id @default(cuid())
  name             String
  shopName         String?             @map("shop_name")
  phone            String
  phone2           String?
  whatsapp         String?
  email            String?
  commune          String?
  address          String?
  lat              Float?
  lng              Float?
  pieces           String[]
  piecesLibre      String?             @map("pieces_libre")
  remarques        String?
  statut           ContactStatus       @default(A_CONTACTER)
  relanceLe        DateTime?           @map("relance_le")
  derniereVisite   DateTime?           @map("derniere_visite")
  derniereCommande DateTime?           @map("derniere_commande")
  notesAppel       String?             @map("notes_appel")
  photos           String[]
  liens            VendorContactLink[]
  activites        ContactActivity[]

  // Provenance du lead : MANUEL (saisie terrain), OSM (radar boutiques
  // CompetitorVendor) ou slug de source externe (COINAFRIQUE_CI, …).
