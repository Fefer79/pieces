  sourceRef String? @map("source_ref")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  liaisonId   String? @map("liaison_id")
  vendorId    String? @map("vendor_id")
  vendor      Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([source, sourceRef], name: "uq_vendor_contacts_source_ref")
  @@index([phone], name: "idx_vendor_contacts_phone")
  @@index([liaisonId], name: "idx_vendor_contacts_liaison")
  @@index([statut], name: "idx_vendor_contacts_statut")
  @@index([relanceLe], name: "idx_vendor_contacts_relance")
  @@index([createdById], name: "idx_vendor_contacts_created_by")
