enum ContactActivityType {
  APPEL
  WHATSAPP
  VISITE
  NOTE
  STATUT
  ASSIGNATION
  CONVERSION
}

model ContactActivity {
  id          String              @id @default(cuid())
  contactId   String              @map("contact_id")
  contact     VendorContact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId    String?             @map("author_id")
  author      User?               @relation("ContactActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  type        ContactActivityType
  note        String?
  statutAvant ContactStatus?      @map("statut_avant")
  statutApres ContactStatus?      @map("statut_apres")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([contactId, createdAt], name: "idx_contact_activities_contact")
  @@index([authorId], name: "idx_contact_activities_author")
  @@map("contact_activities")
}

model VendorContactLink {
  id        String        @id @default(cuid())
  contactId String        @map("contact_id")
  contact   VendorContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  url       String
  type      String
  label     String?
  scrapedAt DateTime?     @map("scraped_at")
  rawData   Json?         @map("raw_data")

  @@unique([contactId, url], name: "uq_vendor_contact_link_url")
  @@index([contactId], name: "idx_vendor_contact_links_contact")
  @@map("vendor_contact_links")
}

// ---------------------------------------------------------------------------
// CRM interne — clients & vendeurs (équipe Pièces)
//
// Cible polymorphe subject/subjectId (USER → users.id, VENDOR → vendors.id) :
// même pattern que ActivityLog.targetType/targetId, pas de FK base de données.
// ---------------------------------------------------------------------------

enum CrmSubjectType {
  USER
  VENDOR
}

enum CrmInteractionType {
  NOTE
  APPEL
  WHATSAPP
  VISITE
  EMAIL
  RELANCE
}

enum CrmTaskStatus {
  A_FAIRE
  FAIT
  ANNULE
}

model CrmInteraction {
  id        String             @id @default(uuid())
  subject   CrmSubjectType
  subjectId String             @map("subject_id")
  type      CrmInteractionType
  details   String?
  meta      Json?
  authorId  String             @map("author_id")
  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now()) @map("created_at")

  @@index([subject, subjectId, createdAt(sort: Desc)], name: "idx_crm_interactions_subject")
  @@index([authorId], name: "idx_crm_interactions_author")
  @@map("crm_interactions")
}

model CrmTask {
  id             String         @id @default(uuid())
  titre          String
  notes          String?
  subject        CrmSubjectType
  subjectId      String         @map("subject_id")
  statut         CrmTaskStatus  @default(A_FAIRE)
  echeanceLe     DateTime?      @map("echeance_le")
  rappelEnvoyeAt DateTime?      @map("rappel_envoye_at")
  faitAt         DateTime?      @map("fait_at")
  assigneeId     String?        @map("assignee_id")
  assignee       User?          @relation("CrmTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById    String         @map("created_by_id")
  createdBy      User           @relation("CrmTaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([statut, echeanceLe], name: "idx_crm_tasks_statut_echeance")
  @@index([subject, subjectId], name: "idx_crm_tasks_subject")
  @@index([assigneeId, statut], name: "idx_crm_tasks_assignee")
  @@map("crm_tasks")
}

model CrmTag {
  id          String             @id @default(uuid())
  nom         String             @unique
  couleur     String?
  assignments CrmTagAssignment[]

  @@map("crm_tags")
}

model CrmTagAssignment {
  tagId     String         @map("tag_id")
  tag       CrmTag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  subject   CrmSubjectType
  subjectId String         @map("subject_id")
  createdAt DateTime       @default(now()) @map("created_at")

  @@id([tagId, subject, subjectId])
  @@index([subject, subjectId], name: "idx_crm_tag_assignments_subject")
  @@map("crm_tag_assignments")
}

// ---------------------------------------------------------------------------
// ERP — Marketing (équipe Pièces)
//
// MarketingCampaign est une campagne WhatsApp en masse ciblée via les segments
// CRM calculés (clients / vendeurs) ou un tag CRM. L'audience est résolue au
// lancement (totalCibles) puis à nouveau à l'envoi ; l'envoi est asynchrone
// (job MARKETING_CAMPAIGN_SEND, maxAttempts 1 — jamais de doublon d'envoi).
// Les compteurs finaux (envoyes, echecs, optouts, sans_telephone) sont remplis
// par le worker en fin d'envoi ; les destinataires désabonnés
// (NotificationPreference.whatsapp = false) sont exclus et comptés, jamais
// contactés. Chaque envoi tenté est tracé en CrmInteraction (type RELANCE).
// ---------------------------------------------------------------------------

enum MarketingCampaignStatus {
  BROUILLON
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum MarketingAudienceType {
  SEGMENT_CLIENT
  SEGMENT_VENDEUR
  TAG
}

model MarketingCampaign {
  id            String                  @id @default(uuid())
  nom           String
  message       String
  audienceType  MarketingAudienceType   @map("audience_type")
  audienceValue String                  @map("audience_value")
  statut        MarketingCampaignStatus @default(BROUILLON)
  totalCibles   Int                     @default(0) @map("total_cibles")
  envoyes       Int                     @default(0)
  echecs        Int                     @default(0)
  optouts       Int                     @default(0)
  sansTelephone Int                     @default(0) @map("sans_telephone")
  scheduledAt   DateTime?               @map("scheduled_at")
  startedAt     DateTime?               @map("started_at")
  completedAt   DateTime?               @map("completed_at")
  createdById   String                  @map("created_by_id")
  createdBy     User                    @relation(fields: [createdById], references: [id])
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  @@index([statut])
  @@map("marketing_campaigns")
}

// ---------------------------------------------------------------------------
// ERP — Stock, achats & fournisseurs (équipe Pièces)
//
// StockMovement est la source de vérité : toute variation de quantité passe par
// un mouvement + mise à jour transactionnelle des compteurs (StockLevel et, pour
// les articles vendus sur la marketplace, CatalogItem.stockQuantity).
// ---------------------------------------------------------------------------

enum StockMovementType {
  RECEPTION
  SORTIE_COMMANDE
  AJUSTEMENT
  RESTITUTION
}

enum PurchaseOrderStatus {
  BROUILLON
  ENVOYEE
  EN_TRANSIT
  RECEPTION_PARTIELLE
  RECEPTIONNEE
  ANNULEE
}

model StockLocation {
  id        String   @id @default(uuid())
  nom       String
  type      String   @default("ENTREPOT") // ENTREPOT | BOUTIQUE | TRANSIT
  commune   String?
  adresse   String?
  actif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  levels         StockLevel[]
  movements      StockMovement[]
  purchaseOrders PurchaseOrder[]

  @@map("stock_locations")
}

model StockLevel {
  id            String        @id @default(uuid())
  catalogItemId String        @map("catalog_item_id")
  catalogItem   CatalogItem   @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  locationId    String        @map("location_id")
  location      StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  qtyOnHand     Int           @default(0) @map("qty_on_hand")
  seuilBas      Int           @default(2) @map("seuil_bas")
  // Coût unitaire moyen pondéré (FCFA), null si jamais approvisionné.
  cumpFcfa      Int?          @map("cump_fcfa")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@unique([catalogItemId, locationId], name: "uq_stock_levels_item_location")
  @@index([locationId], name: "idx_stock_levels_location")
  @@map("stock_levels")
}

model StockMovement {
  id               String            @id @default(uuid())
  type             StockMovementType
  catalogItemId    String            @map("catalog_item_id")
  catalogItem      CatalogItem       @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  locationId       String            @map("location_id")
  location         StockLocation     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantite         Int // toujours positive — le type donne le sens
  coutUnitaireFcfa Int?              @map("cout_unitaire_fcfa")
  refType          String?           @map("ref_type") // 'PurchaseOrder' | 'Order' | 'MANUEL'
  refId            String?           @map("ref_id")
  note             String?
  actorId          String?           @map("actor_id")
  actor            User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now()) @map("created_at")

  @@index([catalogItemId, createdAt], name: "idx_stock_movements_item")
  @@index([locationId, createdAt], name: "idx_stock_movements_location")
  @@map("stock_movements")
}

model Supplier {
  id                String   @id @default(uuid())
  nom               String
  pays              String?
  ville             String?
  contactName       String?  @map("contact_name")
  telephone         String?
  whatsapp          String?
  email             String?
  site              String?
  devise            String   @default("AED") // devise de facturation habituelle
  delaiTypiqueJours Int?     @map("delai_typique_jours")
  conditions        String? // incoterm, paiement, MOQ — texte libre
  notes             String?
  actif             Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id                String              @id @default(uuid())
  numero            String              @unique // BC-YYYYMMDD-XXXX
  supplierId        String              @map("supplier_id")
  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  destinationId     String?             @map("destination_id")
  destination       StockLocation?      @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  mode              String              @default("LOCAL") // clés LOGISTICS_MODES (constants/logistics.ts)
  statut            PurchaseOrderStatus @default(BROUILLON)
  devise            String              @default("FCFA")
  tauxChange        Int?                @map("taux_change") // 1 unité devise = N FCFA
  montantEstimeFcfa Int?                @map("montant_estime_fcfa")
  fraisEstimes      Json?               @map("frais_estimes") // { fret, douane, lastMile, total }
  montantReelFcfa   Int?                @map("montant_reel_fcfa")
  envoyeAt          DateTime?           @map("envoye_at")
  etaAt             DateTime?           @map("eta_at")
  recuAt            DateTime?           @map("recu_at")
  notes             String?
  createdById       String              @map("created_by_id")
  createdBy         User                @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  lines          PurchaseOrderItem[]
  sourcingOffers SourcingOffer[]
  shipments      Shipment[]

  @@index([statut], name: "idx_purchase_orders_statut")
  @@index([supplierId], name: "idx_purchase_orders_supplier")
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String        @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  // null = ligne libre (fiche catalogue pas encore créée) : coût tracké, pas d'impact stock.
  catalogItemId   String?       @map("catalog_item_id")
  catalogItem     CatalogItem?  @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  designation     String
  oemReference    String?       @map("oem_reference")
  quantite        Int
  quantiteRecue   Int           @default(0) @map("quantite_recue")
  prixUnitaire    Float         @map("prix_unitaire") // dans la devise du BC
  poidsEstimeKg   Float?        @map("poids_estime_kg")

  @@index([purchaseOrderId], name: "idx_purchase_order_items_po")
  @@map("purchase_order_items")
}

// ---------------------------------------------------------------------------
// Logistique — demandes de cotation (logistique.pieces.ci)
//
// Un seul modèle sert les trois parcours : visiteur sans compte, compte simple
// et flotte. Ce sont les rattachements nullables (userId / enterpriseId /
// vehicleId / partRequestId) qui font la différence — un visiteur les laisse
// tous vides, une flotte les remplit tous.
// ---------------------------------------------------------------------------

enum LogisticsLeadStatus {
  NEW
  CONTACTED
  QUOTING
  QUOTED
  WON
  LOST
  SPAM
}

enum LogisticsLeadSurface {
  LANDING
  CALCULATEUR
  CAMPAIGN
  WHATSAPP
  REFERRAL
  APP
  FLEET
}

enum LogisticsLeadPhotoKind {
  PART
  REGISTRATION_CARD
  OTHER
}

/**
 * Segments de demandeurs pour la logistique. Les quatre premiers sont les cibles
 * de la vitrine logistique.pieces.ci ; les suivants restent proposés car le
 * service est ouvert à tous.
 */
enum LogisticsCustomerType {
  FLEET_VTC
  FLEET_COMPANY
  MINING_BTP
  INDIVIDUAL
  GARAGE
  DEALER
  IMPORTER
  OTHER
}

/**
 * Niveau d'identification de la pièce et du véhicule — à ne pas confondre avec
 * LogisticsConfidence (fiabilité du poids/volume), qui vit côté TS seulement.
 */
enum LeadCertaintyLevel {
  LOW
  MEDIUM
  HIGH
}

enum VehicleEconomyCategory {
  ECONOMY_ICE
  PREMIUM_ICE
  PREMIUM_EV
}

model LogisticsQuoteRequest {
  id        String              @id @default(cuid())
  reference String              @unique
  status    LogisticsLeadStatus @default(NEW)

  // Rattachements — tous nullables (cf. en-tête de section)
  userId        String?      @map("user_id")
  user          User?        @relation("LogisticsLeadOwner", fields: [userId], references: [id], onDelete: SetNull)
  enterpriseId  String?      @map("enterprise_id")
  enterprise    Enterprise?  @relation(fields: [enterpriseId], references: [id], onDelete: SetNull)
  vehicleId     String?      @map("vehicle_id")
  vehicle       Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  partRequestId String?      @map("part_request_id")
  partRequest   PartRequest? @relation(fields: [partRequestId], references: [id], onDelete: SetNull)

  // Contact
  contactName  String                @map("contact_name")
  companyName  String?               @map("company_name")
  phone        String
  whatsapp     String?
  email        String?
  commune      String?
  customerType LogisticsCustomerType @default(OTHER) @map("customer_type")
  fleetSize    Int?                  @map("fleet_size")

  // Pièce
  partName      String  @map("part_name")
  partCategory  String? @map("part_category")
  oemReference  String? @map("oem_reference")
  quantity      Int     @default(1)
  partPriceHint Int?    @map("part_price_hint")
  familyId      String? @map("family_id")

  // Véhicule
  vin                String?
  vinDecoded         Boolean                 @default(false) @map("vin_decoded")
  vehicleBrand       String?                 @map("vehicle_brand")
  vehicleModel       String?                 @map("vehicle_model")
  vehicleYear        Int?                    @map("vehicle_year")
  energyType         VehicleEnergyType?      @map("energy_type")
  economyCategory    VehicleEconomyCategory? @map("economy_category")
  vehicleImmobilized Boolean                 @default(false) @map("vehicle_immobilized")

  // Estimation (recalculée côté serveur — jamais la valeur du client)
  certaintyScore     Int                @default(0) @map("certainty_score")
  certaintyLevel     LeadCertaintyLevel @default(LOW) @map("certainty_level")
  downtimeCostPerDay Int?               @map("downtime_cost_per_day")
  estimateJson       Json?              @map("estimate_json")

  // Provenance / anti-abus (jamais l'IP en clair)
  surface   LogisticsLeadSurface @default(LANDING)
  campaign  String?
  referer   String?
  ipHash    String?              @map("ip_hash")
  userAgent String?              @map("user_agent")
  consentAt DateTime?            @map("consent_at")

  // Jeton d'upload des photos (haché, TTL court)
  uploadTokenHash      String?   @map("upload_token_hash")
  uploadTokenExpiresAt DateTime? @map("upload_token_expires_at")

  // Traitement ops
  assignedToUserId      String?   @map("assigned_to_user_id")
  assignedTo            User?     @relation("LogisticsLeadAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  opsNote               String?   @map("ops_note")
  contactedAt           DateTime? @map("contacted_at")
  quotedAt              DateTime? @map("quoted_at")
  closedAt              DateTime? @map("closed_at")
  lostReason            String?   @map("lost_reason")
  convertedEnterpriseId String?   @map("converted_enterprise_id")

  photos           LogisticsQuoteRequestPhoto[]
  events           LogisticsQuoteRequestEvent[]
  sourcingSearches SourcingSearch[]
  shipments        Shipment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt], name: "idx_logistics_leads_status")
  @@index([phone], name: "idx_logistics_leads_phone")
  @@index([ipHash, createdAt], name: "idx_logistics_leads_ip")
  @@index([assignedToUserId], name: "idx_logistics_leads_assignee")
  @@index([certaintyLevel], name: "idx_logistics_leads_certainty")
  @@index([userId, createdAt], name: "idx_logistics_leads_user")
  @@index([enterpriseId, status], name: "idx_logistics_leads_enterprise")
  @@map("logistics_quote_requests")
}

model LogisticsQuoteRequestPhoto {
  id             String                 @id @default(cuid())
  quoteRequestId String                 @map("quote_request_id")
  quoteRequest   LogisticsQuoteRequest  @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  kind           LogisticsLeadPhotoKind
  url            String
  thumbUrl       String?                @map("thumb_url")
  position       Int                    @default(0)
  createdAt      DateTime               @default(now()) @map("created_at")

  @@index([quoteRequestId], name: "idx_logistics_lead_photos_request")
  @@map("logistics_quote_request_photos")
}

model LogisticsQuoteRequestEvent {
  id             String                @id @default(cuid())
  quoteRequestId String                @map("quote_request_id")
  quoteRequest   LogisticsQuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  fromStatus     LogisticsLeadStatus?  @map("from_status")
  toStatus       LogisticsLeadStatus?  @map("to_status")
  actorUserId    String?               @map("actor_user_id")
  note           String?
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([quoteRequestId, createdAt], name: "idx_logistics_lead_events_request")
  @@map("logistics_quote_request_events")
}

// ---------------------------------------------------------------------------
// ERP — Équipe & commissions (équipe Pièces)
//
// TeamMemberProfile complète User pour les membres internes (liaisons) : taux
// de commission terrain, fonction, activation. AgentObjective fixe des cibles
// mensuelles dont la progression est calculée en direct (jamais stockée).
// AgentCommission est un snapshot mensuel généré depuis les commissions
// plateforme réelles (OrderItem.commissionAmount) des vendeurs gérés par
// l'agent (Vendor.managedByLiaisonId), puis marqué payé : il n'est jamais
// réécrit après paiement.
// ---------------------------------------------------------------------------

enum AgentObjectiveMetric {
  VENDEURS_GERES
  NOUVEAUX_VENDEURS
  PROSPECTS_CONCLUS
  PIECES_AJOUTEES
  INTERACTIONS_CRM
  TACHES_FAITES
  VISITES_TERRAIN
}

enum AgentCommissionStatus {
  ESTIMEE
  DUE
  PAYEE
  ANNULEE
}

model TeamMemberProfile {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fonction          String?
  tauxCommissionPct Int       @default(10) @map("taux_commission_pct")
  actif             Boolean   @default(true)
  embaucheLe        DateTime? @map("embauche_le")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("team_member_profiles")
}

model AgentObjective {
  id        String               @id @default(uuid())
  agentId   String               @map("agent_id")
  agent     User                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  periode   String // 'YYYY-MM'
  metrique  AgentObjectiveMetric
  cible     Int
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@unique([agentId, periode, metrique])
  @@index([periode], name: "idx_agent_objectives_periode")
  @@map("agent_objectives")
}

model AgentCommission {
  id          String                @id @default(uuid())
  agentId     String                @map("agent_id")
  agent       User                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  periode     String // 'YYYY-MM'
  baseFcfa    Int                   @map("base_fcfa")
  tauxPct     Int                   @map("taux_pct")
  montantFcfa Int                   @map("montant_fcfa")
  statut      AgentCommissionStatus @default(DUE)
  paidAt      DateTime?             @map("paid_at")
  note        String?
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@unique([agentId, periode])
  @@index([periode, statut], name: "idx_agent_commissions_periode_statut")
  @@map("agent_commissions")
}

// ---------------------------------------------------------------------------
// Sourcing & Expéditions — docs/sourcing-expeditions-plan-2026-08.md
//
// Le chaînon manquant entre le besoin (LogisticsQuoteRequest / PartRequest) et
// l'achat (PurchaseOrder) : une recherche d'offres réelles sur les sites de
// vente internationaux, arbitrées au coût rendu Abidjan, puis suivies jusqu'à
// la livraison.
//
// ⚠ Les prix des offres viennent d'un agent web : ils sont INDICATIFS tant que
// `priceConfirmed` est faux. Aucun montant non confirmé ne doit être présenté
// au client comme un devis.
// ---------------------------------------------------------------------------

enum SourcingSearchStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Comment le dossier a été constitué. MANUAL est le mode standard : un
/// opérateur saisit lui-même les offres qu'il a relevées. AGENT est la
/// recherche automatique, activée au cas par cas.
enum SourcingSearchOrigin {
  MANUAL
  AGENT
}

enum SourcingOfferStatus {
  CANDIDATE
  SHORTLISTED
  CONTACTED
  REJECTED
  ORDERED
}

enum SourcingChannel {
  MARKETPLACE_INTL
  DISTRIBUTOR_REGIONAL
  EXPORTER
  MANUFACTURER
  LOCAL
}

enum ShipmentCarrier {
  DHL
  FEDEX
  UPS
  TRANSITAIRE
  AIR_CARGO
  SEA_LCL
  POSTAL
  OTHER
}

enum ShipmentStatus {
  SOURCING
  COLLECTED
  IN_TRANSIT
  CUSTOMS
  LOCAL_DELIVERY
  DELIVERED
  CANCELLED
}

model SourcingSearch {
  id String @id @default(cuid())

  // Origine du besoin — l'une ou l'autre, jamais les deux en pratique.
  quoteRequestId String?                @map("quote_request_id")
  quoteRequest   LogisticsQuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  partRequestId  String?                @map("part_request_id")
  partRequest    PartRequest?           @relation(fields: [partRequestId], references: [id], onDelete: SetNull)

  // Snapshot de la requête : la demande peut être modifiée après coup, les
  // offres doivent rester interprétables au regard de ce qui a été cherché.
  partName     String  @map("part_name")
  oemReference String? @map("oem_reference")
  vehicleBrand String? @map("vehicle_brand")
  vehicleModel String? @map("vehicle_model")
  vehicleYear  Int?    @map("vehicle_year")
  quantity     Int     @default(1)

  origin     SourcingSearchOrigin @default(MANUAL)
  status     SourcingSearchStatus @default(PENDING)
  model      String?
  startedAt  DateTime?            @map("started_at")
  finishedAt DateTime?            @map("finished_at")
  error      String?

  createdById String @map("created_by_id")
  createdBy   User   @relation("SourcingSearchCreator", fields: [createdById], references: [id])

  offers SourcingOffer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt], name: "idx_sourcing_searches_status")
  @@index([quoteRequestId], name: "idx_sourcing_searches_quote_request")
  @@index([partRequestId], name: "idx_sourcing_searches_part_request")
  @@map("sourcing_searches")
}

model SourcingOffer {
  id       String         @id @default(cuid())
  searchId String         @map("search_id")
  search   SourcingSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)

  supplierName String          @map("supplier_name")
  channel      SourcingChannel @default(MARKETPLACE_INTL)
  country      String?
  city         String?
  url          String?
  sourceSite   String?         @map("source_site")

  title          String?
  brand          String?
  oemReference   String?        @map("oem_reference")
  // Libellé de condition tel qu'annoncé par la source, mappé sur PartCondition
  // quand c'est possible (chip colorée en UI — DESIGN.md).
  conditionLabel String?        @map("condition_label")
  condition      PartCondition?

  // `priceAmount` est dans `priceCurrency` ; `priceFcfa` est la conversion au
  // taux du jour, figée à l'insertion. `priceConfirmed` reste faux tant qu'un
  // opérateur n'a pas vérifié le prix auprès du vendeur.
  priceAmount    Float?  @map("price_amount")
  priceCurrency  String? @map("price_currency")
  priceFcfa      Int?    @map("price_fcfa")
  priceConfirmed Boolean @default(false) @map("price_confirmed")
  shippingAmount Float?  @map("shipping_amount")

  moq          Int?
  leadTimeDays Int?    @map("lead_time_days")
  weightKg     Float?  @map("weight_kg")
  availability String?

  contactPhone    String? @map("contact_phone")
  contactEmail    String? @map("contact_email")
  contactWhatsapp String? @map("contact_whatsapp")

  confidence      Float               @default(0)
  /// Saisie par un opérateur (lien relevé à la main) plutôt que rapportée par
  /// l'agent. Le distinguer évite de juger de la même façon deux offres qui
  /// n'ont pas la même provenance.
  enteredManually Boolean             @default(false) @map("entered_manually")
  status          SourcingOfferStatus @default(CANDIDATE)
  opsNote         String?             @map("ops_note")
  /// Clé LOGISTICS_MODES forcée par l'ops — sinon déduite du pays.
  chosenMode      String?             @map("chosen_mode")

  purchaseOrderId String?        @map("purchase_order_id")
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([searchId, status], name: "idx_sourcing_offers_search")
  @@index([purchaseOrderId], name: "idx_sourcing_offers_po")
  @@map("sourcing_offers")
}

model Shipment {
  id        String         @id @default(cuid())
  reference String         @unique // EXP-YYYYMMDD-XXXX
  status    ShipmentStatus @default(SOURCING)

  purchaseOrderId String?                @map("purchase_order_id")
  purchaseOrder   PurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  quoteRequestId  String?                @map("quote_request_id")
  quoteRequest    LogisticsQuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)

  carrier        ShipmentCarrier @default(TRANSITAIRE)
  carrierOther   String?         @map("carrier_other")
  trackingNumber String?         @map("tracking_number")
  trackingUrl    String?         @map("tracking_url")
  /// Clé LOGISTICS_MODES (constants/logistics.ts) — même convention que PurchaseOrder.mode.
  mode           String          @default("AIR_STANDARD")

  originCountry String? @map("origin_country")
  originCity    String? @map("origin_city")

  departedAt       DateTime? @map("departed_at")
  etaAt            DateTime? @map("eta_at")
  customsClearedAt DateTime? @map("customs_cleared_at")
  arrivedAt        DateTime? @map("arrived_at")
  deliveredAt      DateTime? @map("delivered_at")

  weightKg           Float? @map("weight_kg")
  volumeDm3          Float? @map("volume_dm3")
  chargeableWeightKg Float? @map("chargeable_weight_kg")
  freightCostFcfa    Int?   @map("freight_cost_fcfa")
  customsCostFcfa    Int?   @map("customs_cost_fcfa")
  lastMileCostFcfa   Int?   @map("last_mile_cost_fcfa")
  totalCostFcfa      Int?   @map("total_cost_fcfa")

  /// Jeton de suivi public, haché (même convention que LogisticsQuoteRequest).
  publicTokenHash String? @map("public_token_hash")
  notes           String?

  createdById String @map("created_by_id")
  createdBy   User   @relation("ShipmentCreator", fields: [createdById], references: [id])

  events ShipmentEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt], name: "idx_shipments_status")
  @@index([purchaseOrderId], name: "idx_shipments_po")
  @@index([quoteRequestId], name: "idx_shipments_quote_request")
  @@map("shipments")
}

model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String   @map("shipment_id")
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  fromStatus ShipmentStatus? @map("from_status")
  toStatus   ShipmentStatus? @map("to_status")
  label      String
  location   String?
  occurredAt DateTime        @default(now()) @map("occurred_at")

  actorUserId String? @map("actor_user_id")
  actor       User?   @relation("ShipmentEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  note        String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([shipmentId, occurredAt], name: "idx_shipment_events_shipment")
  @@map("shipment_events")
}

// ---------------------------------------------------------------------------
// ERP interne — socle (erp.pieces.ci)
// ---------------------------------------------------------------------------

/// Métiers internes. Sans rapport avec `Role`, qui décrit les espaces client.
enum StaffRole {
  DIRECTION
  COMMERCIAL
  COMPTABLE
  ACHETEUR
  MAGASINIER
  OPS_LOGISTIQUE
  SUPPORT
}

/// Lignes d'activité de l'entreprise.
enum BusinessUnit {
  MARKETPLACE
  FLOTTE
  LOGISTIQUE
}

/// Rattachement d'un compte Pièces à l'équipe interne.
///
/// Deux dimensions cohabitent volontairement : `User.roles` ouvre les espaces
/// client, `StaffMember.staffRole` ouvre les sections de l'ERP. Un membre de
/// l'équipe est d'abord un utilisateur normal ; on ne duplique pas son identité.
model StaffMember {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  staffRole StaffRole @map("staff_role")
  /// Lignes d'activité suivies. Informatif au lot 1 : le filtre du cockpit s'y
  /// appuiera quand la ligne d'activité sera portée par les modèles métier.
  businessUnits BusinessUnit[] @map("business_units")
  title         String?
  /// Un membre désactivé perd toutes ses capacités sans perdre son historique.
  active        Boolean        @default(true)
  hiredAt       DateTime?      @map("hired_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([staffRole], name: "idx_staff_members_role")
  @@index([active], name: "idx_staff_members_active")
  @@map("staff_members")
}
