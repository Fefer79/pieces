  NORMAL
  HIGH
  CRITICAL
}

enum PartRequestSource {
  LOCAL
  AIR
  CARGO
  ANY
}

model PartRequest {
  id                     String                  @id @default(uuid())
  enterpriseId           String                  @map("enterprise_id")
  enterprise             Enterprise              @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  vehicleId              String                  @map("vehicle_id")
  vehicle                Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId               String?                 @map("driver_id")
  driver                 Driver?                 @relation(fields: [driverId], references: [id], onDelete: SetNull)
  createdByUserId        String                  @map("created_by_user_id")
  createdByUser          User                    @relation("PartRequestCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  status                 PartRequestStatus       @default(DRAFT)
  description            String?
  partName               String?                 @map("part_name")
  category               String?
  oemReference           String?                 @map("oem_reference")
  urgency                PartRequestUrgency      @default(NORMAL)
  preferredSource        PartRequestSource       @default(ANY) @map("preferred_source")
  maxBudget              Int?                    @map("max_budget")
  approvedByUserId       String?                 @map("approved_by_user_id")
  approvedByUser         User?                   @relation("PartRequestApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt             DateTime?               @map("approved_at")
  rejectionReason        String?                 @map("rejection_reason")
  orderId                String?                 @unique @map("order_id")
  order                  Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  photos                 PartRequestPhoto[]
  events                 PartRequestEvent[]
  logisticsQuoteRequests LogisticsQuoteRequest[]
  sourcingSearches       SourcingSearch[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@index([enterpriseId, status], name: "idx_part_requests_enterprise_status")
  @@index([vehicleId], name: "idx_part_requests_vehicle")
  @@index([createdByUserId], name: "idx_part_requests_created_by")
  @@index([status], name: "idx_part_requests_status")
  @@map("part_requests")
}

model PartRequestPhoto {
